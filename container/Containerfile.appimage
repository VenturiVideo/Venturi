# AppImage build environment. Debian 13 (glibc 2.41) and not the Fedora
# test image: a glibc binary only runs on a glibc >= the build one,
# so the release must be built on the oldest distro we support.
# The repo is not inside the image, it must be mounted at runtime.
FROM docker.io/library/debian:13

# trixie's rust is too old for the 2024 edition of some dependencies:
# toolchain from rustup.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git make nasm pkg-config \
        gcc g++ clang libclang-dev \
        zlib1g-dev libwayland-dev libxkbcommon-dev libx11-dev \
        libvulkan-dev libasound2-dev meson ninja-build \
        patchelf file desktop-file-utils zsync \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable

WORKDIR /workspace
CMD ["scripts/build-appimage.sh"]
